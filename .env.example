# Copy this file to .env and fill in your values. NEVER commit .env to Git.

# From Entra admin center > Overview
TENANT_ID=00000000-0000-0000-0000-000000000000
# Only needed by scripts/seed_users.py
TENANT_DOMAIN=yourname.onmicrosoft.com

# From App registrations > graph-user-sync
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=paste-the-secret-VALUE-here

# Mock REST API (mock_api/server.py)
TARGET_API_URL=http://127.0.0.1:5000

# Optional tuning
PAGE_SIZE=100
MAX_ATTEMPTS=5
REQUEST_TIMEOUT=30
